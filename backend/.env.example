# 后端环境变量示例（复制为 backend/.env，或在部署平台注入）
# ⚠️ backend/.env 已被 .gitignore 忽略，切勿提交到仓库。

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nfti
DB_PASSWORD=change-me
DB_NAME=nfti

DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash

# EmailJS 反馈服务（凭据仅存服务端，前端通过 feedback-send 代理提交）
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
FEEDBACK_RECIPIENT=
