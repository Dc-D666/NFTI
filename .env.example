# NF-BTI / NFTI 环境变量示例
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，切勿提交。

# ── 数据库（MySQL）──
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nfti
DB_PASSWORD=change-me            # ← 必填
DB_NAME=nfti

# ── DeepSeek（AI 生成/反馈）──
DEEPSEEK_API_KEY=sk-your-key-here # ← 必填
DEEPSEEK_MODEL=deepseek-v4-flash

# ── EmailJS 反馈服务（可选，不填则反馈邮件功能不可用）──
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
FEEDBACK_RECIPIENT=

# ── 跨站体验任务（可选）：需与 PatPlayer 的 PAT_TICKET_SECRET 一致 ──
# 不填则该功能不可用，其余功能不受影响
PAT_TICKET_SECRET=
PAT_BASE_URL=https://pat.weaxi.cn
